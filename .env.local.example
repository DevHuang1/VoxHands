# VoxHands Groq AI configuration.
#
# Copy this template to .env.local and paste your Groq API key below.
# Get one at https://console.groq.com/keys
# The server loads .env.local automatically (standard library, no dependency).
# Leave GROQ_API_KEY empty to use the keyword planner.

GROQ_API_KEY=
# Optional: choose a Groq model (defaults to openai/gpt-oss-120b).
GROQ_MODEL=openai/gpt-oss-120b
# Optional: model tried if the primary model fails (defaults to openai/gpt-oss-20b).
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
